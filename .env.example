# Copy to .env (never commit it) and export before running, e.g. `set -a; . ./.env; set +a`

# Alpaca keys. Use PAPER keys from https://app.alpaca.markets (Paper Trading account).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Live trading stays off unless trading.mode is "live" in config.yaml AND this is
# set to exactly: I_UNDERSTAND_THIS_USES_REAL_MONEY
# TRADEBOT_ALLOW_LIVE=
